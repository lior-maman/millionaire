# Copy to .env and adjust for your environment.
# For MongoDB Atlas use a full SRV URI, e.g.:
#   MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=millionaire

# Password required to manage the question bank (add/edit/delete).
# Sent by the client as the X-Admin-Secret header and verified server-side.
ADMIN_SECRET=change-me
